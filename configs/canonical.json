    "checkpoint_output_dir": "UNRESOLVED"
  },
  "few_shot": {
    "way": "UNRESOLVED",
    "shot": "UNRESOLVED",
    "support_size": "UNRESOLVED",
    "query_size": "UNRESOLVED"
  }
